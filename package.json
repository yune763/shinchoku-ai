    "mcp": "node mcp/server.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "join": "node scripts/join-team.mjs",
    "desktop": "next build && electron electron/main.js",
    "desktop:dev": "cross-env ELECTRON_DEV=1 electron electron/main.js",
    "lint": "next lint"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "firebase-admin": "^14.5.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "postcss": "8.5.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20 <23"
  }
