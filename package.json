{
  "name": "shinchoku-ai",
  "version": "0.1.0",
  "private": true,
  "description": "ゴールベースの進捗管理AI基盤（Addness着想・非連携）",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:lan": "next start -H 0.0.0.0",
