# 他PC・他者AIからのアクセスを保護するトークン。
# 設定すると /api/* で Bearer 認証が必須になる（ブラウザの同一オリジン操作は除く）。
# 未設定ならローカル専用（認証なし）。
# 例: openssl rand -hex 24 などで生成した長い値を使う。
API_TOKEN=

# 任意: 表示用のベースURL（MCPやAIに案内するとき用）。
# 例: http://192.168.3.17:3000
PUBLIC_BASE_URL=

# ── クラウド永続保存（Upstash Redis / REST）──
# この2つを設定すると、保存先が data/*.json から Upstash Redis に切り替わる。
# Render など揮発性ディスクの環境でもデータが消えない。
# 未設定ならローカルファイル保存（従来どおり）。
# Upstash コンソール → Redisデータベース作成 → "REST API" の UPSTASH_REDIS_REST_URL / _TOKEN をコピー。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── チーム共有（共有フォルダ同期方式） ──
# 各PCが自分の進捗スナップショットを TEAM_SYNC_DIR に書き出し、全員で読み合う。
# サーバー不要・外部送信なし。OneDrive/Dropbox/Google Drive/Git 等の同期フォルダを指定。
# MEMBER_ID はメンバーごとに必ず別の値にする（ファイル名になる）。
MEMBER_ID=
MEMBER_NAME=
# 例(Windows): C:\Users\you\OneDrive\共有\shinchoku-team
TEAM_SYNC_DIR=
