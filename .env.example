# 他PC・他者AIからのアクセスを保護するトークン。
# 設定すると /api/* で Bearer 認証が必須になる（ブラウザの同一オリジン操作は除く）。
# 未設定ならローカル専用（認証なし）。
# 例: openssl rand -hex 24 などで生成した長い値を使う。
API_TOKEN=

# 任意: 表示用のベースURL（MCPやAIに案内するとき用）。
# 例: http://192.168.3.17:3000
PUBLIC_BASE_URL=

# ── クラウド永続保存 ──
# 保存先は自動選択: Firestore → Upstash → ローカルファイル（どれも未設定ならファイル）。
# Render など揮発性ディスクの環境でも、下記を設定すればデータが消えない。

# (A) Firestore を使う場合（推奨・Firebaseアカウントがある人向け）
# Firebaseコンソール → プロジェクトの設定 → サービスアカウント → 「新しい秘密鍵を生成」でJSONを取得。
# そのJSONファイルの中身を「1行の文字列」にして丸ごと貼る（改行は \n にエスケープ）。
# 任意: 保存先コレクション名（既定 shinchoku）。
FIREBASE_SERVICE_ACCOUNT=
FIRESTORE_COLLECTION=shinchoku

# (B) Upstash Redis を使う場合（Firestoreを使わないときの代替）
# Upstash コンソール → Redis作成 → "REST API" の2値をコピー。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── チーム共有（共有フォルダ同期方式） ──
# 各PCが自分の進捗スナップショットを TEAM_SYNC_DIR に書き出し、全員で読み合う。
# サーバー不要・外部送信なし。OneDrive/Dropbox/Google Drive/Git 等の同期フォルダを指定。
# MEMBER_ID はメンバーごとに必ず別の値にする（ファイル名になる）。
MEMBER_ID=
MEMBER_NAME=
# 例(Windows): C:\Users\you\OneDrive\共有\shinchoku-team
TEAM_SYNC_DIR=
